type Player {
     id: ID!
     name: String
     team: Team
}

enum Team {
        CSK
        MI
        LSG
        RCB
        DC
        GT
}

type Query {
        findAll: [Player]
        findOne(id: ID): Player
}

type Mutation {
    create(name: String, team: Team): Player
    update(name: String, team: Team): Player
    delete(name: String): Player
}